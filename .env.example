# API
PORT=3000
LOG_LEVEL=info

# Database (used when running locally without Docker Compose)
DB_HOST=localhost
DB_PORT=5432
DB_USER=industrial
DB_PASSWORD=industrial
DB_NAME=industrial_events
DATABASE_URL=postgresql://industrial:industrial@localhost:5432/industrial_events

# When using Docker Compose the service name `db` is used as host.

# -- Pool de Postgres ---------------------------------------------------------
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=15000

# -- Limites de consulta ------------------------------------------------------
EVENTS_DEFAULT_LIMIT=100
EVENTS_MAX_LIMIT=1000

# -- Cache en proceso para /events/latest y el catalogo -----------------------
CACHE_ENABLED=true
CACHE_LATEST_TTL_MS=1500
CACHE_CATALOG_TTL_MS=60000
CACHE_MAX_ENTRIES=2000

# -- Rate limit por API key (ventana fija en memoria) -------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=1000
RATE_LIMIT_MAX=50

# -- Bus de tools nativas dentro del POST /events -----------------------------
BUS_CHAIN_TIMEOUT_MS=8000

# -- Apagado ordenado ---------------------------------------------------------
SHUTDOWN_GRACE_MS=10000

# =============================================================================
# DASHBOARD ORQUESTADOR
# =============================================================================

# -- Plataforma ---------------------------------------------------------------
PLATFORM_NAME=IsoTools
# Dominio registrable comun. Cada tool federada vive en <subdominio>.<dominio>,
# segun `subdomain` en src/data/platform/deployments.json. Sin esta variable, las
# tools federadas se muestran "sin desplegar" en vez de generar enlaces rotos.
PLATFORM_DOMAIN=
# Desarrollo local: resuelve cada tool federada a http://localhost:<localPort>.
PLATFORM_LOCAL_TOOLS=false
# Pisa la URL de UNA tool (gana sobre todo lo anterior). El sufijo es el id en
# mayusculas: TOOL_URL_MANAGE_NONCONFORMANCES=http://localhost:8103

# -- Consola ------------------------------------------------------------------
# Sonda de salud hacia las tools federadas. El timeout corto es deliberado: un
# mosaico en gris es mejor que un dashboard colgado esperando a una tool caida.
CONSOLE_HEALTH_TIMEOUT_MS=2500
CONSOLE_HEALTH_TTL_MS=15000
# Donde vive el SPA compilado. Por defecto `web/dist`. Vacio = solo API.
WEB_DIST_DIR=

# =============================================================================
# SINGLE SIGN-ON (OIDC)
# =============================================================================
# El SSO se activa por PRESENCIA de OIDC_ISSUER. Sin el, la consola corre ABIERTA
# (modo desarrollo). Con el puesto pero incompleto, el proceso NO arranca: auth a
# medias es peor que auth ausente, porque parece protegida y no lo esta.

OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Debe coincidir EXACTO con la URI permitida en el IdP.
OIDC_REDIRECT_URI=https://<dominio>/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=
OIDC_SCOPES=openid profile email roles
# Algunos proveedores publican los roles en `groups` en vez de `roles`.
OIDC_ROLES_CLAIM=roles
# Traduccion rol-del-IdP -> rol-de-plataforma, el mas fuerte primero. Vacio usa
# src/data/platform/roles.json tal cual.
OIDC_ROLE_MAP=

# Firma la cookie de sesion. Minimo 32 caracteres: `openssl rand -hex 32`.
SESSION_SECRET=
SESSION_COOKIE_NAME=isotools_session
SESSION_TTL_SECONDS=28800
# `true` quita el atributo Secure. SOLO para correr en local sobre HTTP plano.
SESSION_INSECURE_COOKIES=false
